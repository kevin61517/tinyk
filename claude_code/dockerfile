# 使用 Node.js 22 作為基礎 (Claude CLI 需求)
FROM node:22-slim

# 安裝基礎執行環境 (Python, PHP, Go, Docker CLI)
# 這裡只裝執行環境，不裝專案套件，保持鏡像輕量
RUN apt-get update && apt-get install -y \
    python3 python3-pip \
    php-cli composer \
    docker.io \
    git curl \
    && rm -rf /var/lib/apt/lists/*

# 安裝 Anthropic 官方 Claude Code CLI
RUN npm install -g @anthropic-ai/claude-code

# 設定工作目錄
WORKDIR /workspace

# 讓 Claude 知道它是在 Docker 容器內運行
ENV CLAUDE_DOCKER_MODE=true

# 預設啟動指令
# CMD ["claude"]
# CMD ["python3", "/usr/local/bin/main.py"]